# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets. .env.example files are committed; real .env files never are.
.env
.env.*
!.env.example

# Directus: local CMS state. The schema snapshot in directus/snapshots/ IS
# committed (it is how the collections get rebuilt), but uploads, extensions
# and Postgres data are local-only.
directus/uploads/*
!directus/uploads/.gitkeep
directus/extensions/*
!directus/extensions/.gitkeep
