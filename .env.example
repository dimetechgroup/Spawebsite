# Copy to .env and fill in. Two different kinds of variable live here.

# ── Build-time only (Node, never shipped to the browser) ────────────
# Read by scripts/fetch-content.mjs when pulling article content out of the
# local Directus instance (see directus/docker-compose.yml).
# MUST NOT be VITE_-prefixed: Vite inlines VITE_* into the client bundle, which
# would publish the token to every visitor.
DIRECTUS_URL=http://localhost:8055
DIRECTUS_TOKEN=

# ── Client-side (inlined into the bundle at build time, so public) ──
# Backend that handles contact form and inquiry submissions (see api.ts).
VITE_API_BASE_URL=

# Optional override; defaults to https://api.myspa.co.ke/newsletter/subscribe
VITE_NEWSLETTER_URL=
