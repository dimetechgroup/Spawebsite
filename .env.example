# Cockpit CMS. Content is fetched in the browser, so both values end up in the
# public JavaScript bundle. The key MUST belong to a read-only Cockpit role.
VITE_COCKPIT_URL=https://cms.myspa.co.ke
VITE_COCKPIT_API_KEY=

# Microsoft Clarity project ID (public). Defaults to the MySpa project when
# unset; set it to an empty value to turn Clarity off. Only loads in production builds.
# VITE_CLARITY_ID=ysuyh7vwtx
