# Copy to directus/.env and fill in. Never commit the real .env.
# Generate the two secrets with:
#   openssl rand -hex 32              # SECRET
#   openssl rand -base64 18           # DB_PASSWORD / ADMIN_PASSWORD

# Signs Directus access tokens. Changing it invalidates all sessions.
SECRET=

# Postgres credentials. Must stay in sync with the running db-data volume:
# changing this after first boot locks Directus out of its own database.
DB_PASSWORD=

# Bootstraps the first admin user on an empty database only.
ADMIN_EMAIL=you@dimetechgroup.com
ADMIN_PASSWORD=
